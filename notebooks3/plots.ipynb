   "source": [
    "data1 = np.load(\"paper_data.npz\")\n",
    "data2 = np.load(\"data4.npz\")\n",
    "\n",
    "V_prime_arr = data1['V_prime_arr']\n",
    "V_prime_arr2 = data2['V_prime_arr']\n",
    "bulk = data1['bulk_arr'] * V_prime_arr\n",
    "\n",
    "data1_idxs = np.where(V_prime_arr > 2)\n",
    "nfpfn_arr = np.concatenate([data2['nfpfn_arr'], data1['nfpfn_arr'][data1_idxs]]) * np.concatenate([V_prime_arr2, V_prime_arr[data1_idxs]])\n",
    "bulk2 = np.concatenate([data2['bulk'], data1['bulk_arr'][data1_idxs]]) * np.concatenate([V_prime_arr2, V_prime_arr[data1_idxs]])\n",
    "sfpfs_arr = data1['sfpfs_arr'] * V_prime_arr \n",
    "dfpfd_arr = data1['dfpfd_arr'] * V_prime_arr"
   ]
  },
